<div class="rounded-md border border-black/10">
  <div class="flex items-center gap-1.5 border-b border-black/5 bg-black/[0.02] px-3 py-1.5 text-[10px] text-black/40 md:hidden">
    <svg class="h-3 w-3 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 16l-4-4m0 0l4-4m-4 4h18"/></svg>
    Swipe to see all columns
    <svg class="h-3 w-3 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
  </div>
  <div class="overflow-x-auto">
  <table class="w-full min-w-[600px] text-left text-sm">
    <thead class="bg-black/[0.03] text-xs uppercase text-black/50">
      <tr>
        <th class="px-3 py-2">Post</th>
        <th class="px-3 py-2">Status</th>
        <th class="px-3 py-2">Platforms</th>
        <th class="px-3 py-2">Date</th>
        <th class="px-3 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-black/10 bg-white">
      <% if (!posts.length) { %>
        <tr><td colspan="5" class="px-3 py-6 text-center text-black/55">No posts yet.</td></tr>
      <% } %>
      <% posts.forEach(function(post) { %>
        <%
          const statusLabel = post.status.replace(/_/g, ' ');
          const statusClass = {
            success: 'bg-emerald-50 text-emerald-700',
            partial_success: 'bg-amber-50 text-amber-700',
            manual_action_required: 'bg-teal-50 text-teal-700',
            failed: 'bg-red-50 text-red-700',
            processing: 'bg-blue-50 text-blue-700',
            pending: 'bg-slate-100 text-slate-600',
            draft: 'bg-slate-100 text-slate-500'
          }[post.status] || 'bg-slate-100 text-slate-600';
          const targets = post.platform_targets || [];
        %>
        <tr class="align-top">
          <td class="max-w-[200px] truncate px-3 py-3"><%= post.caption || 'Untitled post' %></td>
          <td class="px-3 py-3">
            <span class="inline-block rounded-full px-2 py-0.5 text-xs font-medium capitalize <%= statusClass %>"><%= statusLabel %></span>
          </td>
          <td class="px-3 py-3">
            <% if (!targets.length) { %>
              <span class="text-xs text-black/40">-</span>
            <% } else { %>
              <div class="flex flex-col gap-1.5">
                <% targets.forEach(function(t) { %>
                  <%
                    const manualStatuses = ['ready_to_publish', 'opened_in_whatsapp', 'published_manually'];
                    const isWhatsapp = t.platform === 'whatsapp_channel';
                    const chipClass = t.status === 'success' || t.status === 'published_manually' ? 'border-emerald-200 bg-emerald-50 text-emerald-700'
                                    : t.status === 'failed' || t.status === 'failed_to_prepare'   ? 'border-red-200 bg-red-50 text-red-700'
                                    : t.status === 'processing'                                    ? 'border-blue-200 bg-blue-50 text-blue-700'
                                    : manualStatuses.includes(t.status)                            ? 'border-teal-200 bg-teal-50 text-teal-700'
                                    :                                                                'border-slate-200 bg-slate-50 text-slate-600';
                    const icon = t.status === 'success' || t.status === 'published_manually' ? 'OK'
                               : t.status === 'failed' || t.status === 'failed_to_prepare'   ? 'X'
                               : t.status === 'processing'                                    ? '...'
                               : manualStatuses.includes(t.status)                            ? '!'
                               :                                                                '-';
                    const platformLabel = isWhatsapp ? 'WhatsApp Channel' : t.platform;
                    const targetName = isWhatsapp ? 'Assisted' : (t.username ? '@' + t.username : '');
                    const whatsappRaw = isWhatsapp ? (t.api_response || {}) : {};
                    const whatsappMedia = Array.isArray(whatsappRaw.media) ? whatsappRaw.media : [];
                    const firstWhatsappMedia = whatsappMedia[0] || null;
                    const whatsappCaption = whatsappRaw.caption || '';
                    const whatsappLink = whatsappRaw.link || '';
                    const whatsappChannelUrl = whatsappRaw.channel_url || '';
                    const whatsappChannelName = whatsappRaw.channel_name || '';
                  %>
                  <div>
                    <span class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-xs font-medium capitalize <%= chipClass %>">
                      <span><%= platformLabel %></span>
                      <% if (targetName) { %><span class="text-black/40"><%= targetName %></span><% } %>
                      <span><%= icon %></span>
                    </span>
                    <% if ((t.status === 'failed' || t.status === 'failed_to_prepare') && t.error_message) { %>
                      <p class="mt-0.5 max-w-[240px] truncate text-xs text-red-500" title="<%= t.error_message %>"><%= t.error_message %></p>
                    <% } %>
                    <% if (t.platform === 'pinterest' && t.status === 'success' && t.remote_post_id) { %>
                      <% if (t.api_response && t.api_response.remote_deleted) { %>
                        <p class="mt-0.5 text-xs text-black/40">Deleted from Pinterest</p>
                      <% } else { %>
                        <form method="post" action="/posts/targets/<%= t.id %>/pinterest/delete-pin"
                              class="mt-1 inline-block"
                              data-confirm="Delete this Pin from Pinterest? This cannot be undone on Pinterest.">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="rounded border border-red-200 px-2 py-0.5 text-xs font-medium text-red-600 hover:bg-red-50">Delete Pin</button>
                        </form>
                      <% } %>
                    <% } %>
                    <% if (isWhatsapp && manualStatuses.includes(t.status) && whatsappRaw.requires_manual_confirmation) { %>
                      <details class="mt-1 rounded-md border border-teal-100 bg-teal-50/40 p-2 text-xs text-black/70">
                        <summary class="cursor-pointer font-medium text-teal-700">WhatsApp assisted actions</summary>
                        <div class="mt-2 space-y-2" data-whatsapp-panel data-target-id="<%= t.id %>" data-open-url="/posts/targets/<%= t.id %>/whatsapp/opened">
                          <script type="application/json" data-whatsapp-payload><%- JSON.stringify({ caption: whatsappCaption, link: whatsappLink, channelUrl: whatsappChannelUrl, channelName: whatsappChannelName, media: whatsappMedia }).replace(/</g, '\\u003c') %></script>
                          <% if (firstWhatsappMedia) { %>
                            <div class="flex items-center gap-2">
                              <% if (firstWhatsappMedia.thumbnail_path) { %>
                                <img src="/<%= firstWhatsappMedia.thumbnail_path %>" class="h-12 w-12 rounded object-cover" alt="">
                              <% } else { %>
                                <div class="flex h-12 w-12 items-center justify-center rounded bg-black/5 text-[10px] text-black/40">Media</div>
                              <% } %>
                              <div class="min-w-0">
                                <p class="truncate font-medium"><%= firstWhatsappMedia.original_name || 'Prepared media' %></p>
                                <p class="text-black/45"><%= whatsappMedia.length %> file<%= whatsappMedia.length === 1 ? '' : 's' %> prepared</p>
                              </div>
                            </div>
                          <% } %>
                          <p class="line-clamp-2 text-black/55"><%= whatsappCaption || 'No caption' %></p>
                          <% if (whatsappChannelUrl) { %>
                            <p class="text-black/45">Prepared for <span class="font-medium"><%= whatsappChannelName || 'your WhatsApp Channel' %></span>. The app can copy/share the prepared media and caption, then open the Channel for manual confirmation.</p>
                          <% } else { %>
                            <p class="text-black/45">Select your Channel and confirm the update inside WhatsApp. Opening WhatsApp does not mark this as published.</p>
                          <% } %>
                          <div class="flex flex-wrap gap-1.5">
                            <button type="button" class="rounded border border-teal-200 px-2 py-1 font-medium text-teal-700 hover:bg-white" data-whatsapp-copy>Copy caption</button>
                            <% whatsappMedia.forEach(function(m, idx) { %>
                              <a href="/<%= m.file_path %>" download class="rounded border border-black/10 px-2 py-1 font-medium text-black/60 hover:bg-white">Download <%= idx + 1 %></a>
                            <% }) %>
                            <% if (whatsappChannelUrl) { %>
                              <button type="button" class="rounded border border-teal-200 px-2 py-1 font-medium text-teal-700 hover:bg-white" data-whatsapp-open-channel>Prepare & Open Channel</button>
                            <% } %>
                            <button type="button" class="rounded border border-teal-200 px-2 py-1 font-medium text-teal-700 hover:bg-white" data-whatsapp-share>Open/Share to WhatsApp</button>
                            <% if (t.status !== 'published_manually') { %>
                              <form method="post" action="/posts/targets/<%= t.id %>/whatsapp/mark-published" data-confirm="Mark this WhatsApp Channel post as manually published?">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="rounded bg-teal-600 px-2 py-1 font-medium text-white hover:bg-teal-700">Mark as published</button>
                              </form>
                            <% } %>
                          </div>
                        </div>
                      </details>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </td>
          <td class="px-3 py-3 text-black/55">
            <% if (post.status === 'pending' && post.scheduled_for) { %>
              <%
                const sf = new Date(post.scheduled_for);
                const sfPad = (n) => String(n).padStart(2, '0');
                const sfFallback = sf.getUTCFullYear() + '-' + sfPad(sf.getUTCMonth()+1) + '-' + sfPad(sf.getUTCDate()) +
                                   'T' + sfPad(sf.getUTCHours()) + ':' + sfPad(sf.getUTCMinutes());
              %>
              <div class="flex items-center gap-1">
                <span id="sched-label-<%= post.id %>" class="text-xs" data-utc-label="<%= sf.toISOString() %>"></span>
                <button type="button" data-toggle="sched-form-<%= post.id %>"
                        class="rounded p-0.5 text-black/30 hover:text-black/70" title="Edit schedule">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </button>
              </div>
              <form id="sched-form-<%= post.id %>" method="post"
                    action="/posts/<%= post.id %>/reschedule"
                    class="hidden mt-1 flex items-center gap-1">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="datetime-local" name="scheduledFor" value="<%= sfFallback %>" data-utc="<%= sf.toISOString() %>"
                       class="rounded border border-black/15 px-2 py-0.5 text-xs">
                <button type="submit" class="rounded bg-mint px-2 py-0.5 text-xs font-medium text-white">Save</button>
                <button type="button" data-hide="sched-form-<%= post.id %>"
                        class="rounded border border-black/15 px-2 py-0.5 text-xs">X</button>
              </form>
            <% } else { %>
              <span data-utc-label="<%= new Date(post.scheduled_for || post.created_at).toISOString() %>"></span>
            <% } %>
          </td>
          <td class="px-3 py-3 text-right">
            <div class="flex items-center justify-end gap-1">
              <a href="/posts/new?copyFrom=<%= post.id %>"
                 class="rounded px-2 py-1 text-xs font-medium text-mint hover:bg-emerald-50" title="Copy as new post">Copy</a>
              <% if (post.status === 'pending' || post.status === 'failed') { %>
                <a href="/posts/<%= post.id %>/edit"
                   class="rounded px-2 py-1 text-xs font-medium <%= post.status === 'failed' ? 'text-amber-600 hover:bg-amber-50' : 'text-black/50 hover:bg-black/5' %>"><%= post.status === 'failed' ? 'Retry' : 'Edit' %></a>
              <% } %>
              <form method="post" action="/posts/<%= post.id %>?_method=DELETE" data-confirm="Remove this post?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="rounded px-2 py-1 text-xs font-medium text-red-600 hover:bg-red-50">Remove</button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
</div>
