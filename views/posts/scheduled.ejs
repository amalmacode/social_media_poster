<div class="space-y-5">
  <div class="flex items-center justify-between">
    <h1 class="text-3xl font-semibold tracking-tight">Scheduled posts</h1>
    <a href="/posts/new" class="rounded-md bg-ink px-4 py-2 text-sm font-semibold text-white">Create Post</a>
  </div>

  <!-- Filters -->
  <form method="get" action="/scheduled" class="rounded-lg border border-black/10 bg-white p-4 shadow-sm">
    <div class="flex flex-wrap items-end gap-3">
      <div class="min-w-[140px] flex-1">
        <label class="block text-xs font-medium text-black/55">Brand</label>
        <select name="brand" class="mt-1 w-full rounded-md border border-black/15 px-3 py-2 text-sm">
          <option value="">All brands</option>
          <% brands.forEach(function(b) { %>
            <option value="<%= b.id %>" <%= filters.brand === b.id ? 'selected' : '' %>><%= b.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="min-w-[140px] flex-1">
        <label class="block text-xs font-medium text-black/55">Account</label>
        <select name="account" class="mt-1 w-full rounded-md border border-black/15 px-3 py-2 text-sm">
          <option value="">All accounts</option>
          <% accounts.forEach(function(a) { %>
            <option value="<%= a.id %>" <%= filters.account === a.id ? 'selected' : '' %>>
              <%= a.platform %> — @<%= a.username %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="min-w-[140px] flex-1">
        <label class="block text-xs font-medium text-black/55">From</label>
        <input type="date" name="from" value="<%= filters.from %>"
          class="mt-1 w-full rounded-md border border-black/15 px-3 py-2 text-sm">
      </div>

      <div class="min-w-[140px] flex-1">
        <label class="block text-xs font-medium text-black/55">To</label>
        <input type="date" name="to" value="<%= filters.to %>"
          class="mt-1 w-full rounded-md border border-black/15 px-3 py-2 text-sm">
      </div>

      <div class="flex items-center gap-2">
        <button type="submit" class="rounded-md bg-mint px-4 py-2 text-sm font-semibold text-white">Filter</button>
        <% if (filters.brand || filters.account || filters.from || filters.to) { %>
          <a href="/scheduled" class="rounded-md border border-black/15 px-4 py-2 text-sm font-medium text-black/55 hover:bg-black/5">Clear</a>
        <% } %>
      </div>
    </div>
  </form>

  <%- include('../partials/postTable', { posts }) %>
</div>
